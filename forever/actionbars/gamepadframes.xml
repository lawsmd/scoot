<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\FrameXML\UI.xsd">
	<!--
	forever/actionbars/gamepadframes.xml
	The virtual templates of Camelot's gamepad bar replica (gamepad.lua), from
	Blizzard_GamepadActionBars' templates under Camelot names. A slot is two
	frames. The visual button is the art of Blizzard's gamepad button template
	transcribed (ActionBarButton.xml) onto the plain ActionButtonTemplate, with
	Blizzard's button mixins and the two Camelot mixins after them and no
	secure template, so Blizzard's expand, collapse and press styles can move
	and resize it in a fight; it takes no mouse. The click target is a secure
	action button with nothing drawn, made at the bar's load under a click
	layer beside the bar, laid over its visual out of combat. A bar is
	GamepadActionBarTemplate transcribed (ActionBarTemplates.xml) with Camelot
	buttons, without the frame strata and the Edit Mode focus frames only
	Blizzard's Edit Mode sequences read. The page unit is
	GamepadActionBarPageUnitTemplate's geometry: four anchors, each with an
	action bar and a hidden mirror bar, the page tracker, the three
	modifier icons, and the shoulder targeting art MainActionBarFrame.xml
	adds to its instance; the targeting bars stand in the top anchor's
	mirror, and the class action buttons are left out. The mixins are in
	gamepadmixins.lua, which loads first. Every instance is made at build,
	from gamepad.lua.
	-->

	<!-- One input icon: a Camelot stand-in for InputIconTextureFrameTemplate,
	whose load registers with Blizzard's icon set manager. -->
	<Frame name="CamelotGamepadInputIconTemplate" virtual="true" mixin="CamelotGamepadInputIconMixin">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- Two input icons with a plus between them: InputPromptTwoIconTemplate's
	geometry (InputPrompts.xml), the LT+RT prompt under the bottom bar. The
	divider is 16 wide with 4 on each side, as SetDividerType sizes it, so
	the pair is 72 wide. -->
	<Frame name="CamelotGamepadInputPairTemplate" virtual="true" mixin="CamelotGamepadInputPairMixin">
		<Size x="72" y="24"/>
		<Frames>
			<Frame parentKey="First" inherits="CamelotGamepadInputIconTemplate">
				<Anchors>
					<Anchor point="TOPLEFT"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Divider" inherits="CamelotGamepadInputIconTemplate">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_PROMPT_DIVIDER_PLUS" type="global"/>
				</KeyValues>
				<Size x="16" y="16"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.First" relativePoint="RIGHT" x="4" y="0"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Second" inherits="CamelotGamepadInputIconTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Divider" relativePoint="RIGHT" x="4" y="0"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- The visual button: GamepadActionBarButtonTemplate's layers and
	animations (ActionBarButton.xml:4-108) on ActionButtonTemplate and the
	quick keybind template, the two templates Blizzard's ActionBarButtonTemplate
	adds to its secure code template. The mixin stack is Blizzard's button's
	without the secure mixin, the two Camelot mixins last. The four scripts
	resolve to the Camelot mixins; the mouse scripts the base templates carry
	never fire, since the button takes no mouse. -->
	<CheckButton name="CamelotGamepadButtonTemplate" inherits="ActionButtonTemplate, QuickKeybindButtonTemplate" mixin="ActionBarActionButtonDerivedMixin, ActionBarButtonMixin, GamepadActionBarStandardButtonMixin, CamelotActionButtonMixin, CamelotGamepadButtonMixin" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="SpecialActionIcon" file="Interface\Cursor\Interact" hidden="true" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="PermaboundOverlay" atlas="gamepad-actionbar-circleslot-permabound" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="-1">
				<MaskTexture parentKey="CircleMask" atlas="CircleMask" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="icon"/>
						<MaskedTexture childKey="Flash"/>
						<MaskedTexture childKey="SpecialActionIcon"/>
					</MaskedTextures>
				</MaskTexture>
				<MaskTexture parentKey="SquareMask" atlas="SquareMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="icon"/>
						<MaskedTexture childKey="Flash"/>
						<MaskedTexture childKey="SpecialActionIcon"/>
					</MaskedTextures>
				</MaskTexture>
				<Texture parentKey="CircleShadow" atlas="gamepad-actionbar-circleslot-dropshadow" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="CircleShadowFocus" atlas="gamepad-actionbar-focus-bg-circ" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SquareShadow" atlas="gamepad-actionbar-squareslot-dropshadow" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SquareShadowFocus" atlas="gamepad-actionbar-focus-bg-square" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="7">
				<Texture parentKey="CircleGlowFocus" atlas="gamepad-actionbar-fx-circglw" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-4" y="4"/>
						<Anchor point="BOTTOMRIGHT" x="4" y="-4"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SquareGlowFocus" atlas="gamepad-actionbar-fx-squareglw" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-5" y="5"/>
						<Anchor point="BOTTOMRIGHT" x="5" y="-5"/>
					</Anchors>
				</Texture>
				<FontString parentKey="RangeIndicator" inherits="NumberFontNormalSmallGray" text="RANGE_INDICATOR" justifyH="CENTER" hidden="true">
					<Size x="32" y="10"/>
					<Anchors>
						<Anchor point="CENTER" x="10" y="10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="EditModeSquareFocusStartAnim" setToFinalAlpha="true">
				<Alpha childKey="SquareGlowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0"/>
				<Alpha childKey="SquareShadowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0.6"/>
			</AnimationGroup>
			<AnimationGroup parentKey="GameplayModeSquareFocusStartAnim" setToFinalAlpha="true">
				<Alpha childKey="SquareShadowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0.4"/>
			</AnimationGroup>
			<AnimationGroup parentKey="EditModeCircleFocusStartAnim" setToFinalAlpha="true">
				<Alpha childKey="CircleGlowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0"/>
				<Alpha childKey="CircleShadowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0.6"/>
			</AnimationGroup>
			<AnimationGroup parentKey="GameplayModeCircleFocusStartAnim" setToFinalAlpha="true">
				<Alpha childKey="CircleShadowFocus" duration="0.33" order="1" fromAlpha="1" toAlpha="0.4"/>
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</CheckButton>

	<!-- The click target: the secure action button of a slot, one per
	bindable slot, under a click layer beside the bar. A CheckButton on
	ActionButtonTemplate, the pair Blizzard's UpdateFlyout names ("a
	barebones combo of ActionButtonTemplate + SecureActionButtonTemplate"),
	held at alpha 0 so none of the template's art shows. OnLoad and
	OnAttributeChanged stay the template's: Forever's SECURE_ACTIONS.action
	reads the flyout popup off the button, and UpdateFlyout writes that
	field and the popup direction from the attributes, securely, on every
	attribute change. A Camelot call writing either would end every click
	in a forbidden UseAction. The secure template listed last owns OnClick;
	OnHide is the flyout template's, which closes an open popup. -->
	<CheckButton name="CamelotGamepadClickTemplate" inherits="ActionButtonTemplate, SecureActionButtonTemplate" mixin="CamelotGamepadClickMixin" virtual="true">
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnDragStart method="OnDragStart"/>
			<OnReceiveDrag method="OnReceiveDrag"/>
			<PostClick method="PostClick"/>
		</Scripts>
	</CheckButton>

	<!-- The bar: GamepadActionBarTemplate's Left and Right groups of four,
