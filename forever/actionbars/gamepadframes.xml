	<!-- The page unit: GamepadActionBarPageUnitTemplate's four anchors, each
	with an action bar and a hidden mirror, the page tracker (its slots are
	made at build), the three modifier icons, anchored under the side and
	bottom bars as Blizzard's are, and the shoulder targeting art
	MainActionBarFrame.xml adds to Blizzard's instance: a box above each
	side of the top bar, its icon (the watcher copies Blizzard's atlas) and
	its pressed art. The layers come after the frames: a layer anchors to
	the top anchor, which has to exist first. -->
	<Frame name="CamelotGamepadPageUnitTemplate" virtual="true" mixin="CamelotGamepadPageUnitMixin">
		<Size x="656" y="202"/>
		<Frames>
			<Frame name="$parentTop" parentKey="TopAnchor">
				<Size x="50" y="50"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="58"/>
				</Anchors>
				<Frames>
					<Frame name="$parentBar" parentKey="Bar" inherits="CamelotGamepadBarTemplate">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="top" type="string"/>
							<KeyValue key="slotOffset" value="0" type="number"/>
						</KeyValues>
					</Frame>
					<Frame name="$parentMirror" parentKey="Mirror" inherits="CamelotGamepadBarTemplate" hidden="true">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="top" type="string"/>
							<KeyValue key="slotOffset" value="0" type="number"/>
							<KeyValue key="isMirror" value="true" type="boolean"/>
						</KeyValues>
					</Frame>
				</Frames>
			</Frame>
			<Frame name="$parentLeft" parentKey="LeftAnchor">
				<Size x="50" y="50"/>
				<Anchors>
					<Anchor point="CENTER" x="-195" y="0"/>
				</Anchors>
				<Frames>
					<Frame name="$parentBar" parentKey="Bar" inherits="CamelotGamepadBarTemplate">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="left" type="string"/>
							<KeyValue key="slotOffset" value="8" type="number"/>
						</KeyValues>
					</Frame>
					<Frame name="$parentMirror" parentKey="Mirror" inherits="CamelotGamepadBarTemplate" hidden="true">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="left" type="string"/>
							<KeyValue key="slotOffset" value="8" type="number"/>
							<KeyValue key="isMirror" value="true" type="boolean"/>
						</KeyValues>
					</Frame>
				</Frames>
			</Frame>
			<Frame name="$parentRight" parentKey="RightAnchor">
				<Size x="50" y="50"/>
				<Anchors>
					<Anchor point="CENTER" x="195" y="0"/>
				</Anchors>
				<Frames>
					<Frame name="$parentBar" parentKey="Bar" inherits="CamelotGamepadBarTemplate">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="right" type="string"/>
							<KeyValue key="slotOffset" value="16" type="number"/>
						</KeyValues>
					</Frame>
					<Frame name="$parentMirror" parentKey="Mirror" inherits="CamelotGamepadBarTemplate" hidden="true">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="right" type="string"/>
							<KeyValue key="slotOffset" value="16" type="number"/>
							<KeyValue key="isMirror" value="true" type="boolean"/>
						</KeyValues>
					</Frame>
				</Frames>
			</Frame>
			<Frame name="$parentBottom" parentKey="BottomAnchor">
				<Size x="50" y="50"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="-58"/>
				</Anchors>
				<Frames>
					<Frame name="$parentBar" parentKey="Bar" inherits="CamelotGamepadBarTemplate">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="bottom" type="string"/>
							<KeyValue key="slotOffset" value="24" type="number"/>
						</KeyValues>
					</Frame>
					<Frame name="$parentMirror" parentKey="Mirror" inherits="CamelotGamepadBarTemplate" hidden="true">
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<KeyValues>
							<KeyValue key="anchorKey" value="bottom" type="string"/>
							<KeyValue key="slotOffset" value="24" type="number"/>
							<KeyValue key="isMirror" value="true" type="boolean"/>
						</KeyValues>
					</Frame>
				</Frames>
			</Frame>
			<Frame parentKey="PageTracker" hidden="true">
				<Size x="98" y="40"/>
				<Anchors>
					<Anchor point="BOTTOM" relativeKey="$parent.TopAnchor" relativePoint="TOP" x="0" y="20"/>
				</Anchors>
			</Frame>
			<Frame parentKey="LeftIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_TRIGGER_LEFT" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="CENTER" relativeKey="$parent.LeftAnchor.Bar" x="0" y="-35"/>
				</Anchors>
			</Frame>
			<Frame parentKey="RightIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_TRIGGER_RIGHT" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="CENTER" relativeKey="$parent.RightAnchor.Bar" x="0" y="-35"/>
				</Anchors>
			</Frame>
			<Frame parentKey="CenteredIcons" inherits="CamelotGamepadInputPairTemplate" hidden="true">
				<KeyValues>
					<KeyValue key="key1" value="GAMEPAD_TRIGGER_LEFT" type="global"/>
					<KeyValue key="key2" value="GAMEPAD_TRIGGER_RIGHT" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="CENTER" relativeKey="$parent.BottomAnchor.Bar" x="0" y="-35"/>
				</Anchors>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-1">
				<Texture parentKey="LeftShoulderBackground" atlas="gamepad-targeting-left-shoulder-bg" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.TopAnchor" relativePoint="CENTER" x="-108" y="42"/>
					</Anchors>
				</Texture>
