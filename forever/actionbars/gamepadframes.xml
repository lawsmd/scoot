	KeyValues anchorKey, slotOffset and isMirror come from the page unit. -->
	<Frame name="CamelotGamepadBarTemplate" virtual="true" mixin="GamepadActionBarMixin, CamelotGamepadBarMixin">
		<Size x="300" y="200"/>
		<Frames>
			<Frame parentKey="Left">
				<Size x="256" y="128"/>
				<Anchors>
					<Anchor point="LEFT"/>
				</Anchors>
				<Frames>
					<CheckButton name="$parentActionButton1" parentKey="ActionButton1" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="LEFT" x="10" y="0"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_LEFT" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="RIGHT" x="17" y="0"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton2" parentKey="ActionButton2" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="LEFT" x="57" y="39"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_TOP" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="BOTTOM" x="0" y="-17"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton3" parentKey="ActionButton3" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="LEFT" x="104" y="0"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_RIGHT" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="LEFT" x="-17" y="0"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton4" parentKey="ActionButton4" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="LEFT" x="57" y="-39"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_BOTTOM" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="TOP" x="0" y="17"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
				</Frames>
			</Frame>
			<Frame parentKey="Right">
				<Size x="256" y="128"/>
				<Anchors>
					<Anchor point="RIGHT"/>
				</Anchors>
				<Frames>
					<CheckButton name="$parentActionButton5" parentKey="ActionButton1" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="RIGHT" x="-104" y="0"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_FACE_LEFT" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="RIGHT" x="17" y="0"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton6" parentKey="ActionButton2" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="RIGHT" x="-57" y="39"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_FACE_TOP" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="BOTTOM" x="0" y="-17"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton7" parentKey="ActionButton3" inherits="CamelotGamepadButtonTemplate">
						<Anchors>
							<Anchor point="RIGHT" x="-10" y="-1"/>
						</Anchors>
						<Frames>
							<Frame parentKey="ButtonIcon" inherits="CamelotGamepadInputIconTemplate" hidden="true">
								<KeyValues>
									<KeyValue key="mappedButtonKey" value="GAMEPAD_FACE_RIGHT" type="global"/>
								</KeyValues>
								<Size x="20" y="20"/>
								<Anchors>
									<Anchor point="LEFT" x="-17" y="0"/>
								</Anchors>
							</Frame>
						</Frames>
					</CheckButton>
					<CheckButton name="$parentActionButton8" parentKey="ActionButton4" inherits="CamelotGamepadButtonTemplate">
