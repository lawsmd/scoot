## Interface: 120100, 16001
## Title: Camelot
## Notes: Classic-look unit frames for Forever. Development build, not released.
## Author: Scooter
## Version: 0.0.1
## SavedVariables: CamelotDB
## SlashCmd: /camelot
## Dependencies: Blizzard_ObjectiveTracker, Blizzard_ActionBar

## Two interface numbers, one TOC. 120100 is retail 12.1.0 and 16001 is
## Forever build 1.60.1; each client takes the number from the list that
## matches its own, and neither asks for the out-of-date tick. Forever picks
## no game-level flavor suffix, so both clients read this plain Camelot.toc
## (docs/camelot/client.md).

## Libraries. Camelot loads these itself rather than relying on the other addon
## having gone first: WoW loads addons in alphabetical order, so Camelot always
## precedes Scoot, and it has to stand alone on a client where Scoot is absent.
## LibStub returns the already-registered copy when another addon got there
## first, so listing them twice on one machine costs nothing.
libs/LibStub/LibStub.lua
libs/CallbackHandler-1.0/CallbackHandler-1.0.xml
libs/AceEvent-3.0/AceEvent-3.0.xml
libs/AceDB-3.0/AceDB-3.0.xml
libs/LibDataBroker-1.1/LibDataBroker-1.1.lua
libs/LibDBIcon-1.0/lib.xml
libs/LibEditMode/embed.xml
libs/LibEditModeOverride/LibEditModeOverride.xml
libs/AceSerializer-3.0/AceSerializer-3.0.xml
libs/LibDeflate/LibDeflate.lua

## Identity before everything else. A file both TOCs list reads addon.Brand,
## addon.MediaPath, addon.SlashToken and addon.MinimapIcon, several at file
## scope, so the entry file goes first; core/identity.lua is its twin on
## Scoot.toc.
forever/camelot.lua

## Reused from Scoot, listed rather than copied. WoW passes each addon its own
## `addon` table, so every file below loads a second, private instance here and
## Scoot's copy is untouched. This list is the shared/ promotion list, written
## by use; docs/unitframesclassic/ufcharness.md records why each row is on it.
core/secretsafe.lua
core/percent.lua
core/debug/core.lua
core/events.lua
core/strata.lua
core/colors.lua
core/nativeframe.lua

## Primitives the ported components stand on. framestate first: enforce, the
## off-screen unlock and the component system read addon.FrameState at file
## scope. petbattle stands on events; borders on secretsafe and strata above;
## catalogs on nothing, and ui/v2/settings/Helpers.lua reads it at file scope.
core/framestate.lua
core/petbattle.lua
core/catalogs.lua
core/borders.lua

## What the settings framework stands on. commands before fonts and before
## any ui/v2 file, since both register debug commands at file scope; media
## before fonts, which reads addon.MediaTokens at file scope; pool before
## HighScoreWindow; dialogs before controls/Dialog. lsm asks LibStub quietly,
## so no LibSharedMedia is listed and the bundled media answers instead.
## apply_all holds the Global Font and Bar Texture values behind the media
## tokens; it registers a debug command at file scope and reads addon.db at
## call time. forever/db.lua below creates the db.global.media table it writes.
## blindfit sizes the unit frame names and reads fonts.lua at call time.
core/commands.lua
core/escapekey.lua
core/media.lua
core/lsm.lua
core/fonts.lua
core/fontpair.lua
core/blindfit.lua
core/pool.lua
core/aurarow.lua
core/iconratio.lua
core/barborders.lua
core/dialogs.lua
core/apply_all.lua

## Keeps a region hidden that Blizzard re-shows. After commands.lua, because it
## registers a debug command at file scope; after framestate and secretsafe.
core/enforce.lua

## The minimap button. One file for both addons: it reads its icon off
## addon.MinimapIcon, set above, and its storage off addon.MinimapButtonStore,
## which forever/minimap.lua below sets, both at login. commands.lua above
## it, because it registers a slash command at file scope.
core/minimap.lua

## addon:OpenCooldownManagerSettings, which the toolbar's Cooldown Manager
## button and the Game Menu call.
core/cooldownsettings.lua

## Edit Mode. persist goes first of the core/editmode/ files: it creates
## addon.EditMode and holds the LibEditModeOverride handle and the SaveLayouts
## hook for the profile engine below. session holds CloseEditMode and
## positionables the LibEditMode registration for the addon's own frames; they
## stand on secretsafe, events, commands and debug/core above. The presentation
## half is ui/v2/editmode/ below. core is the reader and writer for Blizzard's
## own Edit Mode settings (GetSetting, WriteSetting, IsEditModeActiveOrOpening);
## forever/profiles.lua calls its Initialize. offscreenunlock is the clamp
## removal a component describes a family over; it reads addon.FrameState at
## file scope.
core/editmode/persist.lua
core/editmode/session.lua
core/editmode/core.lua
core/editmode/positionables.lua
core/editmode/offscreenunlock.lua

## The profile engine, one AceDB profile per Edit Mode layout. layouts and spec
## alias what profiles/core assigns at the end of its chunk, and debug/export
## reads addon.DumpReloadDebugLog off it at file scope. The host side is
## forever/profiles.lua below (docs/profiles/profiles.md).
core/profiles/core.lua
core/profiles/layouts.lua
core/profiles/spec.lua
core/importexport.lua
core/debug/export.lua

## Camelot
forever/db.lua
forever/features.lua
forever/profiles.lua
forever/recolor.lua

## Dynamic Layouts: resolver publishes base-or-dynamic edges; tween is the
## OnUpdate driver; engine holds the adapter registry and reads the store seam
## at call time; view is the state behind the dynamic view of Edit Mode, which
## ui/v2/editmode/DynamicView.lua draws. The host, forever/dynamiclayouts/
## host.lua, follows forever/components.lua below so its Features row lists
## after Minimap and Tooltip. Stands on events, commands, debug/core,
## editmode/positionables, profiles/core and forever/db.lua above. No
## game-type gate: retail runs the engine with zero adapters.
core/dynamiclayouts/resolver.lua
core/dynamiclayouts/tween.lua
core/dynamiclayouts/engine.lua
core/dynamiclayouts/view.lua

## The component system, shared, and its host. base/core holds registration,
## the settings table behind component.db and the apply pass; the host answers
## that table from forever/db.lua through addon.ComponentStore and owns the
## module gate (docs/sharing.md, "The seams"). The host registers Features rows
## at file scope, so it precedes forever/menu.lua. The components after it
## register an initializer at file scope and run on both clients. minimap/core
## creates the namespace its siblings read at file scope, and reads
## addon.Enforce there; minimap/offscreenunlock reads addon.OffscreenUnlock.
core/components/base/core.lua
forever/components.lua
## The Dynamic Layouts host: the store seam, the defaults, the Features row
## and the profile step (docs above the engine's block).
forever/dynamiclayouts/host.lua
core/components/minimap/core.lua
core/components/minimap/zonetext.lua
core/components/minimap/coordinates.lua
core/components/minimap/clock.lua
core/components/minimap/buttons.lua
core/components/minimap/dial.lua
core/components/minimap/offscreenunlock.lua
core/components/minimap/overlay.lua
core/components/tooltip.lua
## The HUD, the unit frames and the cast bar, is Forever's alone. Retail loads
## this TOC too, through the AddOns\Camelot junction, for the settings panel,
## so every HUD line carries [ExcludeLoadGameType standard]: retail's game type
## is standard and Forever's is camelot. The exclude form is the one that holds
## on both clients, because 12.1.0 has never heard of camelot and loads a line
## gated on an unknown token (docs/camelot/probe.md, "Reading the Loading
## section"). forever/unitframes/text.lua is the exception: it holds the text
## settings and their defaults, and the pages in forever/unitframes/page.lua
## below draw on retail too, where a stored value can be checked across a
## reload while the beta keeps none.
forever/unitframes/text.lua
forever/unitframes/settings.lua
forever/unitframes/art.lua [ExcludeLoadGameType standard]
forever/unitframes/artplayer.lua [ExcludeLoadGameType standard]
forever/unitframes/arttarget.lua [ExcludeLoadGameType standard]
forever/unitframes/arttot.lua [ExcludeLoadGameType standard]
forever/unitframes/artpet.lua [ExcludeLoadGameType standard]
forever/unitframes/values.lua [ExcludeLoadGameType standard]
forever/unitframes/harness.lua [ExcludeLoadGameType standard]
forever/unitframes/editmode.lua [ExcludeLoadGameType standard]
forever/unitframes/dynamic.lua [ExcludeLoadGameType standard]
forever/unitframes/suppression.lua [ExcludeLoadGameType standard]
forever/unitframes/auras.lua [ExcludeLoadGameType standard]
forever/unitframes/healprediction.lua [ExcludeLoadGameType standard]
forever/unitframes/frame.lua [ExcludeLoadGameType standard]
forever/unitframes/player.lua [ExcludeLoadGameType standard]
forever/unitframes/target.lua [ExcludeLoadGameType standard]
forever/unitframes/tot.lua [ExcludeLoadGameType standard]
forever/unitframes/pet.lua [ExcludeLoadGameType standard]

## Cast bars. The engine is Cast Bar Z's, shared: engine.lua creates the
## namespace, the host fills it from forever/db.lua, the painter draws the
## Classic bar, and the engine files after them read both at the moment of
## use. Stands on events, strata, nativeframe, fonts, editmode/positionables,
## profiles, forever/db.lua and the region reader in forever/unitframes/art.lua.
## casttime.lua is an optional module: the painter creates bar.castTimeText and
## that file owns it. empowered.lua draws on Cast Bar Z's line and caps, so it
## stays off until the Classic bar has a segment layout of its own.
## forever/castbars/dynamic.lua is the Dynamic Layouts adapter, last: it
## fills seams the engine files above it read at the moment of use.
core/components/castbarz/engine.lua [ExcludeLoadGameType standard]
forever/castbars/host.lua [ExcludeLoadGameType standard]
forever/castbars/art.lua [ExcludeLoadGameType standard]
forever/castbars/painter.lua [ExcludeLoadGameType standard]
core/components/castbarz/casttime.lua [ExcludeLoadGameType standard]
core/components/castbarz/anchoring.lua [ExcludeLoadGameType standard]
core/components/castbarz/suppression.lua [ExcludeLoadGameType standard]
core/components/castbarz/events.lua [ExcludeLoadGameType standard]
core/components/castbarz/editmode.lua [ExcludeLoadGameType standard]
forever/castbars/dynamic.lua [ExcludeLoadGameType standard]

## The objective tracker: Blizzard's modular tracker on Camelot-owned frames
## (docs/objectivetracker/replica.md). style.lua holds the settings, their
## defaults and the apply, and loads on retail too for the page below, like
## forever/unitframes/text.lua; mixins.lua defines the globals the XML names
## in mixin= attributes, so it precedes the XML; frames.xml declares the
## container, the module twins and the two item button templates from
## Blizzard_ObjectiveTracker's virtual templates, which the Dependencies line
## above guarantees are parsed by then; tracker.lua wires the manager, parks
## Blizzard's frame and registers the Edit Mode positionables; itembutton.lua
## stands the secure quest item buttons on the blocks' slots; current.lua keeps
## the Current Objectives pane's state and routes quests between the panes
## (docs/objectivetracker/current.md); flash.lua flashes a count that rises in
## that pane; fade.lua cross-fades a quest's blocks as it moves between the
## panes; overflow.lua fades the pane's last lines when it truncates;
## card.lua and cards.lua draw the Camelot style of the pane, a row of quest
## cards (docs/objectivetracker/cards.md);
## dynamic.lua is the Dynamic Layouts adapter for both panes.
## Stands on nativeframe, events, strata,
## pool, fonts, colors, editmode/positionables, forever/db.lua,
## forever/profiles.lua and forever/features.lua.
forever/objectivetracker/style.lua
forever/objectivetracker/mixins.lua [ExcludeLoadGameType standard]
forever/objectivetracker/frames.xml [ExcludeLoadGameType standard]
forever/objectivetracker/tracker.lua [ExcludeLoadGameType standard]
forever/objectivetracker/itembutton.lua [ExcludeLoadGameType standard]
forever/objectivetracker/current.lua [ExcludeLoadGameType standard]
forever/objectivetracker/flash.lua [ExcludeLoadGameType standard]
forever/objectivetracker/fade.lua [ExcludeLoadGameType standard]
forever/objectivetracker/overflow.lua [ExcludeLoadGameType standard]
forever/objectivetracker/card.lua [ExcludeLoadGameType standard]
forever/objectivetracker/cards.lua [ExcludeLoadGameType standard]
forever/objectivetracker/dynamic.lua [ExcludeLoadGameType standard]

## Action bars: Forever's bars on Camelot-owned frames (docs/actionbars/
## replica.md and clusters.md). style.lua holds the module, its switch and
## its defaults; events.lua forwards the button events, runs the tick the
## buttons register with from their own load, and keeps the blocked-action
## log, so it precedes the XML; mixins.lua defines the two globals the XML
## names in mixin= attributes, so it precedes the XML too; frames.xml
## declares the eight bars and their button templates from
## Blizzard_ActionBar's virtual templates, which the Dependencies line above
## guarantees are parsed by then; paging.lua puts the page driver on Action
## Bar 1; clusters.lua adopts the bars into their clusters, lays them out
## and holds the cluster edits; editmode.lua registers each cluster in Edit
## Mode with the dialog's rows, overlays.lua draws the member strips on a
## selected cluster, and dynamic.lua gives it its Dynamic Layouts adapter,
## all after clusters.lua, which they hang off; suppression.lua parks
## Blizzard's bars; bars.lua builds on world entry and registers /camelot
## actionbars. page.lua, the Clusters page, sits in the page block below.
## Stands on nativeframe, events, strata, editmode/positionables,
## dynamiclayouts, forever/db.lua and forever/features.lua. Every line is
## Forever's alone, style.lua included.
forever/actionbars/style.lua [ExcludeLoadGameType standard]
forever/actionbars/events.lua [ExcludeLoadGameType standard]
forever/actionbars/mixins.lua [ExcludeLoadGameType standard]
forever/actionbars/frames.xml [ExcludeLoadGameType standard]
forever/actionbars/paging.lua [ExcludeLoadGameType standard]
forever/actionbars/clusters.lua [ExcludeLoadGameType standard]
forever/actionbars/editmode.lua [ExcludeLoadGameType standard]
forever/actionbars/overlays.lua [ExcludeLoadGameType standard]
forever/actionbars/dynamic.lua [ExcludeLoadGameType standard]
forever/actionbars/suppression.lua [ExcludeLoadGameType standard]
forever/actionbars/bars.lua [ExcludeLoadGameType standard]

## The Personal Resource Display: Forever's PRD on a Camelot-owned frame
## (docs/personalresourcedisplay/replica.md). style.lua holds the module, its
## switch, its settings and the apply, and loads on retail too for the page
## below, like forever/objectivetracker/style.lua; mixins.lua defines the
## global frames.xml names in a mixin= attribute, so it precedes the XML;
## frames.xml declares the frame from Blizzard's XML under Camelot names, with
## no Blizzard template inherited; display.lua feeds the bars from the player
## unit, parks Blizzard's frame and registers /camelot prd; editmode.lua the
## positionable and the dialog mirror; dynamic.lua the Dynamic Layouts
## adapter. Stands on nativeframe, events, strata, colors, fonts, borders,
## barborders, editmode/positionables, dynamiclayouts/engine, forever/db.lua,
## forever/features.lua, forever/profiles.lua and the unit frames' values.lua
## and healprediction.lua above.
forever/personalresourcedisplay/style.lua
forever/personalresourcedisplay/mixins.lua [ExcludeLoadGameType standard]
forever/personalresourcedisplay/frames.xml [ExcludeLoadGameType standard]
forever/personalresourcedisplay/display.lua [ExcludeLoadGameType standard]
forever/personalresourcedisplay/editmode.lua [ExcludeLoadGameType standard]
forever/personalresourcedisplay/dynamic.lua [ExcludeLoadGameType standard]

