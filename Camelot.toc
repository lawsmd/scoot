## The Dynamic Layouts strip on the Edit Mode box and the dynamic view's
## panel, shield and border, over core/dynamiclayouts/view.lua, and the tabs
## that stand in for a frame sent off-screen. Camelot only until Scoot adopts
## the feature.
ui/v2/editmode/DynamicTabs.lua
ui/v2/editmode/DynamicView.lua
ui/v2/GameMenu.lua

## The two profile pages that call only addon.Profiles and addon.ImportExport.
## Presets and Rules stand on Scoot's preset and rules engines and stay on
## Scoot.toc. Both register at file scope, after settingspanel/renderers.lua.
ui/v2/settings/profiles/ManageRenderer.lua
ui/v2/settings/profiles/ImportExportRenderer.lua

## The Apply All pages, Font and Bar Texture, over core/apply_all.lua above.
## Registers both at file scope after settingspanel/renderers.lua; the nav in
## forever/menu.lua lists the Font page only until Camelot has a bar texture
## field. Reads Controls, Theme, addon.Dialogs and addon.FontDisplayNames.
ui/v2/settings/applyall/ApplyAllRenderer.lua

## The accessor factories and the builder's composite blocks (AddTextStyleBlock,
## AddOffsetPair and the rest), then the Tooltip page that uses them.
## Helpers reads addon.FontStyles and addon.Catalogs at file scope,
## BuilderComposites reads Helpers; the page registers at file scope after
## settingspanel/renderers.lua. The Minimap page is the replica's own,
## forever/minimap/page.lua below.
ui/v2/settings/Helpers.lua
ui/v2/settings/BuilderComposites.lua
ui/v2/settings/interface/TooltipRenderer.lua

## The aura tracker's settings surface: the editor's tabs, picker, fly-outs,
## carousel and window, then the Aura List page, which registers its renderer
## at file scope after settingspanel/renderers.lua. Every file reads
## addon.ScootAuras at call time; the controls they stand on (Flyout, Preview,
## IconPicker, Window) and BuilderComposites are above.
ui/v2/settings/scootauras/EditorTabs.lua
ui/v2/settings/scootauras/CDMPicker.lua
ui/v2/settings/scootauras/SpecFlyout.lua
ui/v2/settings/scootauras/GearFlyout.lua
ui/v2/settings/scootauras/TitleCarousel.lua
ui/v2/settings/scootauras/EditorWindow.lua
ui/v2/settings/scootauras/AuraListDrag.lua
ui/v2/settings/scootauras/AuraListRenderer.lua

